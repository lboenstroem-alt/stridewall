---
import { routes, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  heading: string;
  body?: string;
  button: string;
}

const { locale, heading, body, button } = Astro.props;
---

<section class="on-dark bg-forest text-cream">
  <div class="container-site py-24 text-center sm:py-28">
    <h2 class="display mx-auto max-w-3xl text-[2rem] sm:text-[2.75rem]">{heading}</h2>
    <span class="rule rule-center mt-10"></span>
    {body && <p class="mx-auto mt-9 max-w-xl leading-relaxed text-cream/70">{body}</p>}
    <a href={routes.kontakt[locale]} class="btn mt-11">{button}</a>
  </div>
</section>
