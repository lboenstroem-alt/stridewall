---
import { routes, ui, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();
---

<footer class="on-dark bg-pine-deep text-cream">
  <div class="container-site py-14 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a href={routes.home[locale]} class="inline-block no-underline" aria-label="Stridewall">
          <span class="wordmark block text-[0.95rem] text-cream">Stridewall</span>
          <span class="mt-1.5 block h-px w-14 bg-gold"></span>
        </a>
        <p class="mt-5 max-w-xs text-[0.9375rem] leading-relaxed text-cream/70">
          {t.footerClaim}
        </p>
      </div>
      <nav aria-label={t.footerNav}>
        <h2 class="text-[0.8125rem] font-semibold tracking-[0.18em] text-gold uppercase">
          {t.footerNav}
        </h2>
        <ul class="mt-4 space-y-2.5 text-[0.9375rem]">
          {
            t.nav.map(({ key, label }) => (
              <li>
                <a href={routes[key][locale]} class="text-cream/80 transition-colors hover:text-cream">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label={t.footerLegal}>
        <h2 class="text-[0.8125rem] font-semibold tracking-[0.18em] text-gold uppercase">
          {t.footerLegal}
        </h2>
        <ul class="mt-4 space-y-2.5 text-[0.9375rem]">
          <li>
            <a href={routes.impressum[locale]} class="text-cream/80 transition-colors hover:text-cream">
              Impressum
            </a>
          </li>
          <li>
            <a
              href={routes.datenschutz[locale]}
              class="text-cream/80 transition-colors hover:text-cream"
            >
              Datenschutz
            </a>
          </li>
        </ul>
      </nav>
    </div>
    <div
      class="mt-12 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3 border-t border-cream/15 pt-6 text-[0.8125rem] text-cream/55"
    >
      <p>© {year} Stridewall</p>
      <p>{t.footerNoTracking}</p>
    </div>
  </div>
</footer>
