---
import { routes, ui, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();
---

<footer class="on-dark bg-forest-deep text-cream">
  <div class="container-site py-16 sm:py-20">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <span class="wordmark block text-[0.9375rem] text-cream">Stridewall</span>
        <span class="rule mt-5"></span>
        <p class="mt-6 max-w-xs text-[0.9375rem] leading-relaxed text-cream/65">
          {t.footerClaim}
        </p>
      </div>

      <nav aria-label={t.footerNav}>
        <h2 class="sr-only">{t.footerNav}</h2>
        <ul class="space-y-3 text-[0.9375rem]">
          {
            t.nav.map(({ key, label }) => (
              <li>
                <a href={routes[key][locale]} class="text-cream/80 transition-colors hover:text-gold">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t.footerLegal}>
        <h2 class="sr-only">{t.footerLegal}</h2>
        <ul class="space-y-3 text-[0.9375rem]">
          <li>
            <a href={routes.impressum[locale]} class="text-cream/80 transition-colors hover:text-gold">
              Impressum
            </a>
          </li>
          <li>
            <a href={routes.datenschutz[locale]} class="text-cream/80 transition-colors hover:text-gold">
              Datenschutz
            </a>
          </li>
          <li class="pt-2 text-cream/50">{t.footerNoTracking}</li>
        </ul>
      </nav>
    </div>

    <p class="mt-14 border-t border-cream/12 pt-7 text-[0.8125rem] text-cream/45">
      © {year} Stridewall
    </p>
  </div>
</footer>
