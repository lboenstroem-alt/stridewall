---
interface Props {
  kicker?: string;
  h1: string;
  intro?: string;
}

const { kicker, h1, intro } = Astro.props;
---

<section class="on-dark bg-forest text-cream">
  <div class="container-site py-20 text-center sm:py-28">
    {kicker && <p class="caps kicker">{kicker}</p>}
    <h1 class="display mx-auto mt-7 max-w-4xl text-[2.25rem] sm:text-5xl">{h1}</h1>
    <span class="rule rule-center mt-9"></span>
    {
      intro && (
        <p class="mx-auto mt-9 max-w-2xl text-lg leading-relaxed text-cream/75">{intro}</p>
      )
    }
  </div>
</section>
