---
interface Props {
  kicker?: string;
  h1: string;
  intro?: string;
}

const { kicker, h1, intro } = Astro.props;
---

<section class="border-b border-ink/10 bg-cream">
  <div class="container-site py-16 sm:py-24">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1
      class="mt-5 max-w-3xl font-serif text-[2.25rem] leading-[1.1] font-semibold text-pine sm:text-5xl"
    >
      {h1}
    </h1>
    {
      intro && (
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-stone">{intro}</p>
      )
    }
  </div>
</section>
