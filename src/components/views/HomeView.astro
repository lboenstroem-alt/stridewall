---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaSection from '../CtaSection.astro';
import { routes, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entry = await getEntry('pages', `${locale}/home`);
if (!entry) throw new Error(`Missing content: pages/${locale}/home`);
const d = entry.data as any;

const steps = (await getCollection('steps', ({ id }) => id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base locale={locale} pageKey="home" title={d.title} description={d.description}>
  <!-- Hero -->
  <section class="on-dark bg-forest text-cream">
    <div class="container-site py-28 text-center sm:py-36">
      <p class="wordmark text-[1.375rem] text-cream sm:text-[1.75rem]">Stridewall</p>
      <span class="rule rule-center mt-7"></span>

      <h1 class="display mx-auto mt-14 max-w-4xl text-[2.5rem] sm:text-[3.5rem] lg:text-[4rem]">
        {d.hero.h1}
      </h1>
      <span class="rule rule-center mt-12"></span>

      <p class="mx-auto mt-12 max-w-2xl text-lg leading-relaxed text-cream/75">
        {d.hero.sub}
      </p>

      <div class="mt-14 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
        <a href={routes.kontakt[locale]} class="btn">{d.hero.cta}</a>
        <a href={routes.vorgehen[locale]} class="link-caps">{d.steps.linkLabel}</a>
      </div>
    </div>
  </section>

  <!-- The gap -->
  <section class="bg-cream">
    <div class="container-site py-24 sm:py-28">
      <div class="text-center">
        <p class="caps kicker">{d.stats.kicker}</p>
        <h2 class="display mx-auto mt-7 max-w-3xl text-[2rem] sm:text-[2.75rem]">
          {d.stats.heading}
        </h2>
      </div>

      <dl
        class="mt-20 grid border-t border-ink/12 sm:grid-cols-3 sm:divide-x sm:divide-ink/12"
      >
        {
          d.stats.items.map((s: { value: string; text: string }) => (
            <div class="border-b border-ink/12 px-0 py-10 sm:border-b-0 sm:px-9 sm:first:pl-0 sm:last:pr-0">
              <dt class="figures font-serif text-[2.75rem] leading-none font-medium text-ink">
                {s.value}
              </dt>
              <span class="rule mt-5 w-8" />
              <dd class="mt-6 text-[0.9375rem] leading-relaxed text-stone">{s.text}</dd>
            </div>
          ))
        }
      </dl>

      <p class="mx-auto mt-14 max-w-2xl text-center text-sm leading-relaxed text-stone/75">
        {d.stats.source}
      </p>
    </div>
  </section>

  <!-- What we do -->
  <section class="bg-cream">
    <div class="container-site pb-24 sm:pb-28">
      <div class="text-center">
        <p class="caps kicker">{d.steps.kicker}</p>
        <h2 class="display mt-7 text-[2rem] sm:text-[2.75rem]">{d.steps.heading}</h2>
      </div>

      <ol class="mt-20 grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s) => (
            <li>
              <span class="figures caps block text-gold-ink">
                {String(s.data.order).padStart(2, '0')}
              </span>
              <span class="mt-4 block h-px w-full bg-ink/15" />
              <h3 class="mt-7 font-serif text-[1.5rem] leading-tight font-medium text-ink">
                {s.data.title}
              </h3>
              <p class="mt-4 text-[0.9375rem] leading-relaxed text-stone">{s.data.teaser}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-16 text-center">
        <a href={routes.vorgehen[locale]} class="link-caps">{d.steps.linkLabel}</a>
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="bg-sand">
    <div class="container-site py-24 text-center sm:py-28">
      <p class="caps kicker">{d.proof.kicker}</p>
      <blockquote
        class="display mx-auto mt-10 max-w-4xl text-[1.75rem] leading-[1.35] sm:text-[2.125rem]"
      >
        {d.proof.quote}
      </blockquote>
      <span class="rule rule-center mt-12"></span>
      <p class="caps mt-10 text-stone/80">{d.proof.attribution}</p>
    </div>
  </section>

  <!-- Why now -->
  <section class="bg-cream">
    <div class="container-site py-24 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-20">
        <div>
          <p class="caps kicker">{d.whynow.kicker}</p>
          <h2 class="display mt-7 text-[1.875rem] sm:text-[2.375rem]">{d.whynow.heading}</h2>
        </div>
        <div>
          <p class="text-[1.0625rem] leading-[1.75] text-stone">{d.whynow.body}</p>
          <a href={routes.kiVerordnung[locale]} class="link-caps mt-9">{d.whynow.linkLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <CtaSection locale={locale} heading={d.cta.heading} body={d.cta.body} button={d.cta.button} />
</Base>
