---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaSection from '../CtaSection.astro';
import { routes, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entry = await getEntry('pages', `${locale}/home`);
if (!entry) throw new Error(`Missing content: pages/${locale}/home`);
const d = entry.data as any;

const steps = (await getCollection('steps', ({ id }) => id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base locale={locale} pageKey="home" title={d.title} description={d.description}>
  <!-- Hero -->
  <section class="on-dark bg-pine text-cream">
    <div class="container-site py-24 sm:py-32 lg:py-36">
      <div class="max-w-4xl">
        <h1 class="font-serif text-[2.5rem] leading-[1.08] font-semibold sm:text-6xl lg:text-[4rem]">
          {d.hero.h1}
        </h1>
        <span class="mt-10 block h-px w-24 bg-gold"></span>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-cream/80 sm:text-xl">
          {d.hero.sub}
        </p>
        <a href={routes.kontakt[locale]} class="btn-gold mt-11">{d.hero.cta}</a>
      </div>
    </div>
  </section>

  <!-- The gap -->
  <section class="border-b border-ink/10 bg-cream">
    <div class="container-site py-20 sm:py-24">
      <p class="kicker">{d.stats.kicker}</p>
      <h2
        class="mt-5 max-w-3xl font-serif text-[2rem] leading-[1.15] font-semibold text-pine sm:text-[2.75rem]"
      >
        {d.stats.heading}
      </h2>
      <dl class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-3">
        {
          d.stats.items.map((s: { value: string; text: string }) => (
            <div class="border-t border-gold pt-6">
              <dt class="font-serif text-[2.75rem] leading-none font-semibold text-pine sm:text-5xl">
                {s.value}
              </dt>
              <dd class="mt-4 text-[0.9375rem] leading-relaxed text-stone">{s.text}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-12 max-w-2xl text-sm leading-relaxed text-stone/80">{d.stats.source}</p>
    </div>
  </section>

  <!-- What we do -->
  <section class="bg-paper">
    <div class="container-site py-20 sm:py-24">
      <p class="kicker">{d.steps.kicker}</p>
      <h2
        class="mt-5 font-serif text-[2rem] leading-[1.15] font-semibold text-pine sm:text-[2.75rem]"
      >
        {d.steps.heading}
      </h2>
      <ol class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((s) => (
            <li class="border-t border-ink/15 pt-6">
              <span class="font-serif text-2xl leading-none font-semibold text-gold-ink">
                {String(s.data.order).padStart(2, '0')}
              </span>
              <h3 class="mt-4 text-[1.0625rem] font-semibold text-pine">{s.data.title}</h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-stone">{s.data.teaser}</p>
            </li>
          ))
        }
      </ol>
      <a href={routes.vorgehen[locale]} class="btn-outline-dark mt-12">{d.steps.linkLabel}</a>
    </div>
  </section>

  <!-- Proof -->
  <section class="on-dark bg-pine-deep text-cream">
    <div class="container-site py-20 sm:py-24">
      <div class="grid items-start gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-20">
        <div>
          <p class="text-[0.8125rem] font-semibold tracking-[0.18em] text-gold uppercase">
            {d.proof.kicker}
          </p>
          <blockquote
            class="mt-7 border-l-2 border-gold pl-6 font-serif text-2xl leading-[1.45] text-cream italic sm:text-[1.75rem]"
          >
            {d.proof.quote}
          </blockquote>
        </div>
        <div class="border-t border-cream/20 pt-6 lg:border-t-0 lg:border-l lg:border-cream/20 lg:pt-0 lg:pl-10">
          <p class="font-serif text-[2.25rem] leading-[1.1] font-semibold text-gold sm:text-[2.5rem]">
            {d.proof.figure}
          </p>
          <p class="mt-4 text-[0.9375rem] leading-relaxed text-cream/75">{d.proof.caption}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why now -->
  <section class="border-b border-ink/10 bg-cream">
    <div class="container-site py-20 sm:py-24">
      <div class="max-w-2xl">
        <p class="kicker">{d.whynow.kicker}</p>
        <h2
          class="mt-5 font-serif text-[2rem] leading-[1.15] font-semibold text-pine sm:text-[2.5rem]"
        >
          {d.whynow.heading}
        </h2>
        <p class="mt-6 text-[1.0625rem] leading-relaxed text-stone">{d.whynow.body}</p>
        <a href={routes.kiVerordnung[locale]} class="btn-outline-dark mt-9">
          {d.whynow.linkLabel}
        </a>
      </div>
    </div>
  </section>

  <CtaSection
    locale={locale}
    heading={d.cta.heading}
    body={d.cta.body}
    button={d.cta.button}
  />
</Base>
