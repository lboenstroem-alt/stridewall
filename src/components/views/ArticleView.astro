---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import CtaSection from '../CtaSection.astro';
import type { Locale, PageKey } from '../../lib/i18n';

interface Props {
  locale: Locale;
  pageKey: PageKey;
  /** Content file id under src/content/pages, without the locale prefix. */
  slug: string;
}

const { locale, pageKey, slug } = Astro.props;
const entry = await getEntry('pages', `${locale}/${slug}`);
if (!entry) throw new Error(`Missing content: pages/${locale}/${slug}`);
const d = entry.data as any;
const { Content } = await render(entry);
---

<Base locale={locale} pageKey={pageKey} title={d.title} description={d.description}>
  <PageHeader kicker={d.kicker} h1={d.h1} intro={d.intro} />

  <div class="bg-cream">
    <div class="container-site py-20 sm:py-24">
      <article class="prose mx-auto max-w-2xl">
        <Content />
      </article>
      {
        d.disclaimer && (
          <aside
            class="mx-auto mt-20 max-w-2xl border-t border-gold/60 pt-7 text-[0.9375rem] leading-relaxed text-stone/85"
            aria-label={locale === 'de' ? 'Rechtlicher Hinweis' : 'Legal notice'}
          >
            {d.disclaimer}
          </aside>
        )
      }
    </div>
  </div>

  {
    d.cta && (
      <CtaSection locale={locale} heading={d.cta.heading} body={d.cta.body} button={d.cta.button} />
    )
  }
</Base>
