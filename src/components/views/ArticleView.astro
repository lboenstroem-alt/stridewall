---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import CtaSection from '../CtaSection.astro';
import type { Locale, PageKey } from '../../lib/i18n';

interface Props {
  locale: Locale;
  pageKey: PageKey;
  /** Content file id under src/content/pages, without the locale prefix. */
  slug: string;
}

const { locale, pageKey, slug } = Astro.props;
const entry = await getEntry('pages', `${locale}/${slug}`);
if (!entry) throw new Error(`Missing content: pages/${locale}/${slug}`);
const d = entry.data as any;
const { Content } = await render(entry);
---

<Base locale={locale} pageKey={pageKey} title={d.title} description={d.description}>
  <PageHeader kicker={d.kicker} h1={d.h1} intro={d.intro} />

  <div class="bg-paper">
    <div class="container-site py-16 sm:py-20">
      <article class="prose text-ink">
        <Content />
      </article>
      {
        d.disclaimer && (
          <aside
            class="mt-16 max-w-2xl border-l-2 border-gold-ink/50 bg-sand px-6 py-5 text-[0.9375rem] leading-relaxed text-stone"
            aria-label={locale === 'de' ? 'Rechtlicher Hinweis' : 'Legal notice'}
          >
            {d.disclaimer}
          </aside>
        )
      }
    </div>
  </div>

  {
    d.cta && (
      <CtaSection
        locale={locale}
        heading={d.cta.heading}
        body={d.cta.body}
        button={d.cta.button}
      />
    )
  }
</Base>
