---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entry = await getEntry('pages', `${locale}/kontakt`);
if (!entry) throw new Error(`Missing content: pages/${locale}/kontakt`);
const d = entry.data as any;
const { Content } = await render(entry);
---

<Base locale={locale} pageKey="kontakt" title={d.title} description={d.description}>
  <PageHeader kicker={d.kicker} h1={d.h1} />

  <div class="bg-paper">
    <div class="container-site grid gap-14 py-16 sm:py-20 lg:grid-cols-[1fr_20rem] lg:gap-20">
      <div class="prose text-ink">
        <Content />
      </div>
      <aside class="border-t border-gold pt-7 lg:border-t-0 lg:border-l lg:border-ink/15 lg:pt-1 lg:pl-10">
        <p class="kicker">{d.emailKicker}</p>
        <a
          href={`mailto:${d.email}`}
          class="mt-4 block font-serif text-[1.5rem] leading-tight font-semibold break-words text-pine underline decoration-gold decoration-2 underline-offset-4 hover:text-gold-ink"
        >
          {d.email}
        </a>
        {
          d.bookingUrl && (
            <a
              href={d.bookingUrl}
              rel="noopener"
              class="btn-gold mt-8 w-full text-center"
            >
              {d.bookingLabel}
            </a>
          )
        }
      </aside>
    </div>
  </div>
</Base>
