---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entry = await getEntry('pages', `${locale}/kontakt`);
if (!entry) throw new Error(`Missing content: pages/${locale}/kontakt`);
const d = entry.data as any;
const { Content } = await render(entry);
---

<Base locale={locale} pageKey="kontakt" title={d.title} description={d.description}>
  <PageHeader kicker={d.kicker} h1={d.h1} />

  <div class="bg-cream">
    <div class="container-site py-20 sm:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <p class="caps kicker">{d.emailKicker}</p>
        <a
          href={`mailto:${d.email}`}
          class="mt-6 inline-block font-serif text-[1.75rem] leading-tight font-medium break-words text-ink underline decoration-gold decoration-1 underline-offset-8 transition-colors hover:text-gold-ink sm:text-[2.25rem]"
        >
          {d.email}
        </a>
        {
          d.bookingUrl && (
            <div class="mt-12">
              <a href={d.bookingUrl} rel="noopener" class="btn">
                {d.bookingLabel}
              </a>
            </div>
          )
        }
      </div>

      <span class="rule rule-center mt-20"></span>

      <article class="prose mx-auto mt-20 max-w-2xl">
        <Content />
      </article>
    </div>
  </div>
</Base>
