---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../PageHeader.astro';
import type { Locale, PageKey } from '../../lib/i18n';

interface Props {
  locale: Locale;
  pageKey: PageKey;
  slug: string;
}

const { locale, pageKey, slug } = Astro.props;
const entry = await getEntry('pages', `${locale}/${slug}`);
if (!entry) throw new Error(`Missing content: pages/${locale}/${slug}`);
const d = entry.data as any;
const { Content } = await render(entry);
---

<Base locale={locale} pageKey={pageKey} title={d.title} description={d.description}>
  <PageHeader kicker={d.kicker} h1={d.h1} />
  <div class="bg-cream">
    <div class="container-site py-20 sm:py-24">
      {
        d.notice && (
          <p class="mx-auto mb-14 max-w-2xl border-l border-gold pl-5 text-[0.9375rem] leading-relaxed text-stone/85">
            {d.notice}
          </p>
        )
      }
      <article class="prose mx-auto max-w-2xl">
        <Content />
      </article>
    </div>
  </div>
</Base>
