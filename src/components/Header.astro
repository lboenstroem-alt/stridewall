---
import { routes, ui, altLocale, type Locale, type PageKey } from '../lib/i18n';

interface Props {
  locale: Locale;
  pageKey: PageKey;
}

const { locale, pageKey } = Astro.props;
const t = ui[locale];
const other = altLocale(locale);
const otherPath = routes[pageKey][other];
const switchHref = otherPath !== routes[pageKey][locale] ? otherPath : routes.home[other];
---

<header class="on-dark bg-forest text-cream">
  <div class="container-site flex flex-wrap items-center justify-between gap-x-10 gap-y-5 py-7">
    <a href={routes.home[locale]} aria-label="Stridewall">
      <span class="wordmark block text-[1.0625rem] text-cream">Stridewall</span>
    </a>

    <nav aria-label={t.footerNav}>
      <ul class="caps flex flex-wrap items-center gap-x-8 gap-y-3">
        {
          t.nav.map(({ key, label }) => (
            <li>
              <a
                href={routes[key][locale]}
                aria-current={key === pageKey ? 'page' : undefined}
                class:list={[
                  'transition-colors hover:text-gold',
                  key === pageKey ? 'text-gold' : 'text-cream',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
        <li aria-hidden="true" class="hidden h-4 w-px bg-cream/25 sm:block"></li>
        <li class="flex items-center gap-x-3">
          <span class="text-gold" aria-current="true">{locale.toUpperCase()}</span>
          <a
            href={switchHref}
            rel="alternate"
            hreflang={other}
            lang={other}
            class="text-cream/55 transition-colors hover:text-cream"
            aria-label={t.langSwitch}
          >
            {other.toUpperCase()}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
